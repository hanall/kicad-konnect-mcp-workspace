# 경로를 상대화한 Windows 교차 빌드 toolchain입니다.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/clang-windows-cc-remap.sh" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/clang-windows-cxx-remap.sh" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_TARGET "x86_64-w64-windows-gnu" CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER_TARGET "x86_64-w64-windows-gnu" CACHE STRING "" FORCE)

set(CMAKE_RC_COMPILER "/usr/bin/x86_64-w64-mingw32-windres" CACHE FILEPATH "" FORCE)
set(CMAKE_AR "/usr/bin/x86_64-w64-mingw32-ar" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "/usr/bin/x86_64-w64-mingw32-ranlib" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "/usr/bin/x86_64-w64-mingw32-ld" CACHE FILEPATH "" FORCE)
set(CMAKE_NM "/usr/bin/x86_64-w64-mingw32-nm" CACHE FILEPATH "" FORCE)
set(CMAKE_OBJDUMP "/usr/bin/x86_64-w64-mingw32-objdump" CACHE FILEPATH "" FORCE)
set(CMAKE_STRIP "/usr/bin/x86_64-w64-mingw32-strip" CACHE FILEPATH "" FORCE)
set(CMAKE_DLLTOOL "/usr/bin/x86_64-w64-mingw32-dlltool" CACHE FILEPATH "" FORCE)

set(CMAKE_SYSROOT "/usr/x86_64-w64-mingw32" CACHE PATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH "/usr/x86_64-w64-mingw32" CACHE PATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
